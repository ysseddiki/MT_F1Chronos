# Nom DNS public du VPS (certificat Let's Encrypt automatique via Caddy).
# Ex. simracing-dc.yseddiki.fr — pas d’IP brute, pas « localhost ».
RESULTS_DOMAIN=simracing-dc.yseddiki.fr

# Contact ACME (Let's Encrypt) — obligatoire pour émettre le certificat.
CADDY_EMAIL=admin@yseddiki.fr

# Mot de passe admin INITIAL (premier démarrage uniquement, puis hashé en SQLite).
# Ensuite : le changer dans /admin. Relancer init-env.sh ne change plus le login.
# Vide + aucune base = admin ouvert (à éviter en VPS).
# Générer : ./scripts/init-env.sh
RESULTS_ADMIN_PASSWORD=

# Secret de signature des cookies de session (nécessaire à chaque démarrage).
RESULTS_SECRET=
