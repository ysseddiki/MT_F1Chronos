# Nom d’hôte du serveur (FQDN, nom court LAN ou IP selon le mode TLS).
# Ex. classement.exemple.com · results.lan · 192.168.10.50
RESULTS_DOMAIN=simracing-dc.yseddiki.fr

# Mode TLS Caddy :
#   letsencrypt — Internet public, certificat ACME automatique (défaut)
#   custom      — Réseau fermé / PKI : fullchain.pem + privkey.pem dans ./certs/
#   internal    — HTTPS auto-signé (Caddy tls internal), LAN sans PKI
#   http        — HTTP seul (LAN), pas de TLS côté Caddy
RESULTS_TLS_MODE=letsencrypt

# Contact ACME (obligatoire si RESULTS_TLS_MODE=letsencrypt).
CADDY_EMAIL=admin@yseddiki.fr

# Répertoire des certificats PEM (mode custom). Défaut : ./certs
# RESULTS_TLS_CERT_DIR=./certs

# Cookies Secure (auto si TLS ≠ http). Forcer : true | false
# RESULTS_SECURE_COOKIES=

# Mot de passe admin INITIAL (premier démarrage uniquement, puis hashé en SQLite).
# Ensuite : le changer dans /admin. Relancer init-env.sh ne change plus le login.
# Vide + aucune base = admin ouvert (à éviter en prod).
# Générer : ./scripts/init-env.sh
RESULTS_ADMIN_PASSWORD=

# Secret de signature des cookies de session (nécessaire à chaque démarrage).
RESULTS_SECRET=
