{
	admin off
}

# HTTP seul (LAN fermé, derrière un autre proxy TLS). Pas de chiffrement Caddy.
# Cookies de session non Secure (RESULTS_TLS_MODE=http côté app).
http://{$RESULTS_DOMAIN} {
	encode gzip zstd

	reverse_proxy results:8080 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
