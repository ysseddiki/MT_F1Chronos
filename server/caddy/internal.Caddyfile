{
	admin off
}

# HTTPS auto-signé (Caddy « tls internal ») — réseau fermé sans ACME ni PKI déployée.
# Les clients doivent ignorer l’avertissement TLS ou installer le cert racine Caddy.
{$RESULTS_DOMAIN} {
	tls internal
	encode gzip zstd

	reverse_proxy results:8080 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
