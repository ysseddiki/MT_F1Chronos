{
	email {$CADDY_EMAIL}
	admin off
}

# Internet public : Let's Encrypt (HTTP-01 sur :80, service HTTPS sur :443).
# RESULTS_DOMAIN = FQDN public (pas localhost ni IP seule).
{$RESULTS_DOMAIN} {
	encode gzip zstd

	reverse_proxy results:8080 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
